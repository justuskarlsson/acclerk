    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.1.0",
    "next": "16.0.3",
    "next-auth": "^4.24.13",
    "nodemailer": "^7.0.11",
    "openai": "^6.9.1",
    "pdfjs-dist": "^5.4.394",
    "prisma": "^7.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.66.1",
    "react-pdf": "^10.2.0",
