    "@types/node": "^20",
    "@types/pg": "^8.15.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.3",
    "pg": "^8.16.3",
    "playwright": "^1.57.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5"
