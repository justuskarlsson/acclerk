{
  "name": "next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e .env.dev -- next dev -p 3001",
    "dev:prod": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint",
    "test:smoke": "tsx scripts/smoke-test.ts",
    "test:e2e": "dotenv -e .env.test -- playwright test",
    "test:e2e:watch": "dotenv -e .env.test -- playwright test --ui",
    "test": "pnpm test:smoke && pnpm test:e2e",
    "db:reset": "dotenv -e .env.test -- tsx tests/helpers/db-reset.ts",
    "db:seed": "dotenv -e .env.test -- tsx tests/helpers/db-seed.ts",
    "dev:seed": "dotenv -e .env.dev -- tsx scripts/dev-seed.ts",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "test:storybook": "test-storybook",
    "migrate:dev": "dotenv -e .env.dev -- pnpm prisma migrate deploy",
    "migrate:test": "dotenv -e .env.test -- pnpm prisma migrate deploy",
    "migrate:prod": "pnpm prisma migrate deploy",
    "migrate:all": "pnpm migrate:dev && pnpm migrate:test && pnpm migrate:prod"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@hookform/resolvers": "^5.2.2",
