    "test": "pnpm test:smoke && pnpm test:e2e",
    "db:reset": "dotenv -e .env.test -- tsx tests/helpers/db-reset.ts",
    "db:seed": "dotenv -e .env.test -- tsx tests/helpers/db-seed.ts"
  },
