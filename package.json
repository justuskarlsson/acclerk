{
  "name": "next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e .env.dev -- next dev -p 3001",
    "dev:prod": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint",
    "test:smoke": "tsx scripts/smoke-test.ts",
    "test:e2e": "dotenv -e .env.test -- playwright test",
